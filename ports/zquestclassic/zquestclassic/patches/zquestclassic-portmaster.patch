+// Software-drawn mouse cursor, for KMS/DRM displays without a hardware cursor plane, where
+// the system cursor set by MouseSprite never appears. Enabled with [gui] software_cursor.
+static ALLEGRO_BITMAP* sw_cursor_bmp;
+static int sw_cursor_xf, sw_cursor_yf;
+
+static bool sw_cursor_enabled()
+{
+	static int enabled = -1;
+	if (enabled < 0)
+		enabled = zc_get_config("gui", "software_cursor", 0) ? 1 : 0;
+	return enabled == 1;
+}
+
+static bool sw_cursor_position(int& x, int& y)
+{
+	if (!sw_cursor_enabled() || !sw_cursor_bmp || !al_is_mouse_installed())
+		return false;
+	ALLEGRO_MOUSE_STATE state;
+	al_get_mouse_state(&state);
+	x = state.x - sw_cursor_xf;
+	y = state.y - sw_cursor_yf;
+	return true;
+}
+
+void render_draw_software_cursor()
+{
+	int x, y;
+	if (sw_cursor_position(x, y))
+		al_draw_bitmap(sw_cursor_bmp, x, y, 0);
+}
