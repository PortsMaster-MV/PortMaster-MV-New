+// local edit: let the gamepad d-pad drive menus the same way allegro_legacy's dialogs
+// already do (update_dialog in gui.c turns joystick 0's first stick into arrow keys), so
+// menus don't need a keyboard-mapping tool to inject arrows that dialogs would double.
+static void menu_joystick_to_keys()
+{
+	static bool joy_held = false;
+	if (!num_joysticks)
+		return;
+	poll_joystick();
+	auto const& stick = joy[0].stick[0];
+	int k = 0;
+	if (stick.axis[0].d1) k = KEY_LEFT;
+	else if (stick.axis[0].d2) k = KEY_RIGHT;
+	else if (stick.axis[1].d1) k = KEY_UP;
+	else if (stick.axis[1].d2) k = KEY_DOWN;
+	if (!k)
+	{
+		joy_held = false;
+		return;
+	}
+	if (joy_held)
+		return;
+	joy_held = true;
+	simulate_keypress(k << 8);
+}
